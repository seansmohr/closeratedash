# Copy to .env for local runs (npm run dev needs none of these).
# On Railway, set these as service variables instead.

NODE_ENV=production

# GoHighLevel Private Integration token (Settings > Private Integrations),
# scopes: contacts.readonly and calendars/events.readonly
GHL_TOKEN=
GHL_LOCATION_ID=dTtT96ODx29mbQcdOp0v

# Google service account key file contents (the whole JSON, on one line)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Defaults to the Master Production Live Feed sheet, first tab
SHEET_ID=1oQeRPTmqfCarESRfVO5Kr0farkIo9yVOOH-vzidckwg
SHEET_RANGE=A:U
# The master production workbook (its summary tabs feed the Leaderboards page)
MASTER_SHEET_ID=1YVvXDVkLQmjQ8zgWlC_Ax-qiP9u8uh2wQfALA53KhOc

# Simplest sign-in: one shared password the browser asks for. When set, the Google
# sign-in settings below aren't needed.
DASHBOARD_PASSWORD=

# Google sign-in (OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_DOMAIN=jmohrins.com
# The app's public address, no trailing slash, e.g. https://sales-kpi.up.railway.app
PUBLIC_URL=
# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

# Railway fills this in when you add Postgres (use a reference variable: ${{Postgres.DATABASE_URL}})
DATABASE_URL=

REFRESH_MINUTES=15
TIMEZONE=America/Los_Angeles
